# Copy this file to resources/ms-core/.env; ms-core loads it automatically.
# Variables already defined in the process environment take precedence.
# The database connection is configured only in resources/ms-sql/.env (MS_SQL_URL).
MS_SERVER_KEY=MagicSchoolRP
MS_ALLOWLIST_FORM_URL=
MS_APPROVAL_TIMEOUT_SECONDS=1800
MS_ACCESS_POLL_SECONDS=5

# Required identifiers: accountId, steamId, epicId, discordId, hardwareId (empty = none required).
# "," = AND, "|" = OR. Example: discordId,steamId|epicId -> Discord AND (Steam OR Epic).
MS_REQUIRED_IDENTIFIERS=